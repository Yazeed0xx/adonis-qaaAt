{
  "name": "qaaAt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "start:worker": "node ace queue:work",
    "start:production": "node bin/server.js",
    "start:worker:production": "node ace queue:work",
    "release:migrate": "node ace migration:run --force",
    "verify:production": "npm run typecheck && npm run lint && npm test && npm run build && npm audit --omit=dev",
    "build": "node ace build && node ace openapi:generate && node ace build",
    "openapi:generate": "node ace build && node ace openapi:generate",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#lib/*": "./app/lib/*.js",
    "#schemas/*": "./app/schemas/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^4.2.0",
    "@outloud/adonis-openapi-generator": "^1.0.8",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "eslint": "^9.26.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/queue": "^0.6.0",
    "@boringnode/queue": "^0.5.1",
    "@outloud/adonis-openapi": "^1.0.8",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.3.1",
    "flydrive": "^1.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
